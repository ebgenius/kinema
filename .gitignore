__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Bundled wheels are fetched by tools/fetch_wheels.py, never committed (~112 MB).
/src/kinema/wheels/*.whl

# Build output
/dist/
*.zip

# Scenes the demo scripts save for inspection: tens of MB of packed robot
# meshes, and every one is regenerable by re-running its script.
/tools/demo/blend/

# Where tools/demo/robots.py records the downloaded demo robots. Machine-local
# absolute paths; regenerate by re-running it.
/tools/demo/.robots.json
*.blend
*.blend[0-9]

# Vendored third-party source is fetched by tools/vendor.py, not committed.
/src/kinema/vendor/pyroki/
/src/kinema/vendor/jaxls/

.vscode/
.idea/

# MkDocs build output. The docs sources live on the github-page branch, but
# building them from this checkout drops the result here.
/site/
