<?xml version="1.0"?>
<!-- A parallel gripper whose second finger is a mimic joint, for #104:
     - grip_mirror follows grip, mirrored (the usual parallel gripper);
     - grip_tip follows grip_mirror, itself a mimic: a chain of two;
     - knuckle, revolute, follows lift with an offset;
     - finger_b carries a mesh, which has to move with its finger;
     - tool0 on the arm, where the Tool bone goes, mimics or not. -->
<robot name="mimic_gripper">
  <link name="base"/>
  <link name="arm"/>
  <link name="tool0"/>
  <link name="finger_a"/>
  <link name="finger_b">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.04"/></geometry>
    </visual>
  </link>
  <link name="tip_b"/>
  <link name="finger_c"/>

  <joint name="lift" type="revolute">
    <parent link="base"/><child link="arm"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="1"/>
  </joint>
  <joint name="arm_tool0" type="fixed">
    <parent link="arm"/><child link="tool0"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
  </joint>
  <joint name="grip" type="prismatic">
    <parent link="arm"/><child link="finger_a"/>
    <origin xyz="0.05 0 0.2" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="0" upper="0.04" effort="5" velocity="0.5"/>
  </joint>
  <joint name="grip_mirror" type="prismatic">
    <parent link="arm"/><child link="finger_b"/>
    <origin xyz="-0.05 0 0.2" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.04" upper="0" effort="5" velocity="0.5"/>
    <mimic joint="grip" multiplier="-1.0" offset="0.0"/>
  </joint>
  <joint name="grip_tip" type="prismatic">
    <parent link="finger_b"/><child link="tip_b"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.2" upper="0.2" effort="5" velocity="1"/>
    <mimic joint="grip_mirror" multiplier="2.0" offset="0.01"/>
  </joint>
  <joint name="knuckle" type="revolute">
    <parent link="arm"/><child link="finger_c"/>
    <origin xyz="0 0.05 0.2" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1" upper="1" effort="5" velocity="1"/>
    <mimic joint="lift" multiplier="0.5" offset="0.1"/>
  </joint>
</robot>
