<?xml version="1.0"?>
<!-- The shape that broke on real vendor descriptions: a robot whose xacro
     includes a file from a *sibling* package by name. xacrodoc resolves the
     file's own package unaided but not its neighbours, so this failed with
     PackageNotFoundError until Kinema started telling it where to look.

     Modelled on kroshu/kuka_robot_descriptions, where
     kuka_lbr_iiwa_support reaches kuka_resources for its materials. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fixture_arm">

  <xacro:include filename="$(find fixture_common)/urdf/common_materials.xacro"/>

  <xacro:arg name="prefix" default=""/>
  <xacro:property name="link_len" value="0.3"/>

  <link name="$(arg prefix)base_link"/>

  <!-- Defined in the sibling package: if the include silently produced nothing,
       this invocation fails rather than yielding a robot missing a material. -->
  <xacro:fixture_link name="$(arg prefix)link_1"/>
  <xacro:fixture_link name="$(arg prefix)link_2"/>

  <joint name="$(arg prefix)joint_1" type="revolute">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)link_1"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="2.0"/>
  </joint>

  <joint name="$(arg prefix)joint_2" type="revolute">
    <parent link="$(arg prefix)link_1"/>
    <child link="$(arg prefix)link_2"/>
    <origin xyz="0 0 ${link_len}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="2.0"/>
  </joint>

</robot>
