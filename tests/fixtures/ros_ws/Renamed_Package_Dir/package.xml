<?xml version="1.0"?>
<!-- The directory is Renamed_Package_Dir; the package is fixture_renamed.

     Modelled on Universal_Robots_ROS2_Description, whose package.xml declares
     ur_description, so every $(find ur_description) in it failed against an
     index keyed on the folder name.

     The maintainer name is deliberately non-ASCII. Reading this file with the
     system codec instead of parsing it as XML is what made the UR description
     die on Windows with "'charmap' codec can't decode byte 0x9d". -->
<package format="2">
  <name>fixture_renamed</name>
  <version>0.0.1</version>
  <description>A package whose directory name is not its name.</description>
  <maintainer email="nobody@example.com">Rune Søe-Knudsen</maintainer>
  <license>MIT</license>
</package>
