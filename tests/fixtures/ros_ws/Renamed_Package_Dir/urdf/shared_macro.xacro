<?xml version="1.0"?>
<!-- Reached through $(find fixture_renamed), the declared package name. If the
     index keyed on the directory (Renamed_Package_Dir) this include fails. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="sized_link" params="name length">
    <link name="${name}">
      <visual>
        <geometry><box size="0.05 0.05 ${length}"/></geometry>
      </visual>
    </link>
  </xacro:macro>

</robot>
