<?xml version="1.0"?>
<!-- arm6 on a linear rail: seven joints, but only six of them rotary.

     This is the redundancy most robot cells actually have. The extra joint is
     not an elbow to swing, it is an external axis an operator positions, and the
     arm then reaches from wherever the carriage stands. So the rail is held by
     hand and IK solves the six-axis arm, rather than both being handed to the
     solver as one seven-joint problem it could resolve any way it liked.

     The rail runs along X, under the arm's base. Everything above the carriage
     is arm6 unchanged. -->
<robot name="rail6">
  <material name="steel"><color rgba="0.6 0.6 0.65 1.0"/></material>

  <link name="base">
    <visual>
      <origin xyz="0 0 0.01"/>
      <geometry><box size="3.2 0.12 0.02"/></geometry>
      <material name="steel"/>
    </visual>
  </link>
  <link name="carriage">
    <visual>
      <geometry><box size="0.2 0.2 0.04"/></geometry>
      <material name="steel"/>
    </visual>
  </link>
  <link name="shoulder">
    <visual>
      <geometry><cylinder radius="0.05" length="0.1"/></geometry>
      <material name="steel"/>
    </visual>
  </link>
  <link name="upper_arm">
    <visual>
      <origin xyz="0.2 0 0"/>
      <geometry><box size="0.4 0.07 0.07"/></geometry>
      <material name="steel"/>
    </visual>
  </link>
  <link name="forearm">
    <visual>
      <origin xyz="0.175 0 0"/>
      <geometry><box size="0.35 0.06 0.06"/></geometry>
    </visual>
  </link>
  <link name="wrist_1"/>
  <link name="wrist_2"/>
  <link name="wrist_3"/>
  <link name="tool"/>

  <joint name="rail" type="prismatic">
    <parent link="base"/><child link="carriage"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-1.5" upper="1.5" effort="500" velocity="1.0"/>
  </joint>
  <joint name="joint1" type="revolute">
    <parent link="carriage"/><child link="shoulder"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="150" velocity="3.15"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="shoulder"/><child link="upper_arm"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="150" velocity="3.15"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0.4 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.8" upper="2.8" effort="150" velocity="3.15"/>
  </joint>
  <joint name="joint4" type="revolute">
    <parent link="forearm"/><child link="wrist_1"/>
    <origin xyz="0.35 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="28" velocity="3.2"/>
  </joint>
  <joint name="joint5" type="revolute">
    <parent link="wrist_1"/><child link="wrist_2"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="28" velocity="3.2"/>
  </joint>
  <joint name="joint6" type="revolute">
    <parent link="wrist_2"/><child link="wrist_3"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="28" velocity="3.2"/>
  </joint>
  <joint name="wrist_to_tool" type="fixed">
    <parent link="wrist_3"/><child link="tool"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
  </joint>
</robot>
