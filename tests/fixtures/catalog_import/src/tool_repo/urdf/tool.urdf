<?xml version="1.0"?>
<!-- Names its mesh by a path relative to the repository's top, not to this
     file: the catalog entry's mesh_base says where it starts, as kinema_catalog
     does for SO-ARM100. Resolved against this file's directory, it isn't found. -->
<robot name="fixture_tool">
  <link name="tool_base">
    <visual>
      <geometry><mesh filename="meshes/part.stl"/></geometry>
    </visual>
  </link>
  <link name="finger"/>
  <joint name="finger_joint" type="prismatic">
    <parent link="tool_base"/>
    <child link="finger"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.04" effort="10" velocity="0.1"/>
  </joint>
</robot>
