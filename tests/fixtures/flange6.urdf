<?xml version="1.0"?>
<!-- arm6, with its tool link swapped for a mounting flange as ROS-Industrial
     descriptions define one: both "flange" and "tool0", "flange" first. For the
     TCP-zero tests in test_tcp_mount.py; the arm itself is arm6's. -->
<robot name="flange6">
  <material name="steel"><color rgba="0.6 0.6 0.65 1.0"/></material>

  <link name="base"/>
  <link name="shoulder">
    <visual>
      <geometry><cylinder radius="0.05" length="0.1"/></geometry>
      <material name="steel"/>
    </visual>
  </link>
  <link name="upper_arm">
    <visual>
      <origin xyz="0.2 0 0"/>
      <geometry><box size="0.4 0.07 0.07"/></geometry>
      <material name="steel"/>
    </visual>
  </link>
  <link name="forearm">
    <visual>
      <origin xyz="0.175 0 0"/>
      <geometry><box size="0.35 0.06 0.06"/></geometry>
    </visual>
  </link>
  <link name="wrist_1"/>
  <link name="wrist_2"/>
  <link name="wrist_3"/>
  <link name="tool"/>

  <joint name="joint1" type="revolute">
    <parent link="base"/><child link="shoulder"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="150" velocity="3.15"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="shoulder"/><child link="upper_arm"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="150" velocity="3.15"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0.4 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.8" upper="2.8" effort="150" velocity="3.15"/>
  </joint>
  <joint name="joint4" type="revolute">
    <parent link="forearm"/><child link="wrist_1"/>
    <origin xyz="0.35 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="28" velocity="3.2"/>
  </joint>
  <joint name="joint5" type="revolute">
    <parent link="wrist_1"/><child link="wrist_2"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="28" velocity="3.2"/>
  </joint>
  <joint name="joint6" type="revolute">
    <parent link="wrist_2"/><child link="wrist_3"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="28" velocity="3.2"/>
  </joint>
  <!-- The last link carries a mounting flange twice over, as KUKA's and UR's
       ROS-Industrial descriptions do (REP-199): "flange" with X out of the face,
       "tool0" with Z out of it, both on the face. "flange" comes first, so a pick
       by depth alone lands on it. The placement is the KR10 R1100-2's, with the
       face 28.5 mm along the link's -Z. -->
  <link name="flange"/>
  <link name="tool0"/>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3"/><child link="flange"/>
    <origin xyz="0 0 -0.0285" rpy="0 1.5707963267948966 0"/>
  </joint>
  <joint name="wrist_3-tool0" type="fixed">
    <parent link="wrist_3"/><child link="tool0"/>
    <origin xyz="0 0 -0.0285" rpy="3.141592653589793 0 3.141592653589793"/>
  </joint>
</robot>
