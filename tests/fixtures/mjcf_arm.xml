<!-- Exercises the MJCF features that actually differ from URDF:
     degree angles (MuJoCo's default), <default> class inheritance,
     a joint with a non-zero pos inside its body, a body carrying two
     joints, and a welded body with no joint at all. -->
<mujoco model="mjcf_arm">
  <compiler angle="degree" eulerseq="xyz"/>

  <default>
    <joint type="hinge" axis="0 0 1" range="-90 90"/>
    <geom type="capsule" size="0.02 0.1" rgba="0.5 0.5 0.9 1"/>
    <default class="wrist">
      <joint range="-45 45"/>
      <geom type="sphere" size="0.03"/>
    </default>
  </default>

  <worldbody>
    <body name="base" pos="0 0 0.1">
      <geom name="base_geom" type="box" size="0.05 0.05 0.05"/>

      <body name="shoulder" pos="0 0 0.1">
        <joint name="j1" axis="0 0 1"/>
        <geom name="shoulder_geom"/>

        <body name="upper" pos="0.3 0 0">
          <!-- Joint pivot offset back along the link. This is the case that
               breaks naive readers: URDF has no equivalent offset, so the
               body frame must be restored after the pivot. -->
          <joint name="j2" pos="-0.3 0 0" axis="0 1 0" range="-120 120"/>
          <geom name="upper_geom"/>

          <body name="wrist" pos="0.25 0 0" euler="0 0 30">
            <!-- Two joints on one body: a 2-DoF wrist. -->
            <joint name="j3" axis="0 1 0" class="wrist"/>
            <joint name="j4" axis="1 0 0" class="wrist"/>
            <geom name="wrist_geom" class="wrist"/>

            <body name="tool" pos="0.08 0 0">
              <!-- No joint: welded to the wrist. -->
              <geom name="tool_geom" type="box" size="0.01 0.01 0.02"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
