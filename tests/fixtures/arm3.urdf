<?xml version="1.0"?>
<!-- A deliberately hand-checkable robot:
     base -(fixed, +0.1z)- mount -(rev Z, +0.2z)- l1 -(rev Y, +0.3x)- l2
     -(prismatic X, +0.4x)- l3 -(fixed, +0.05x)- tool
     Fixed joints exist to prove they are folded away rather than boned. -->
<robot name="arm3">
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>

  <link name="base"/>
  <link name="mount"/>
  <link name="l1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.2"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <link name="l2">
    <visual>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.1"/></geometry>
    </visual>
  </link>
  <link name="l3"/>
  <link name="tool"/>

  <joint name="base_to_mount" type="fixed">
    <parent link="base"/><child link="mount"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>
  <joint name="joint1" type="revolute">
    <parent link="mount"/><child link="l1"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="1"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="l1"/><child link="l2"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10" velocity="1"/>
  </joint>
  <joint name="joint3" type="prismatic">
    <parent link="l2"/><child link="l3"/>
    <origin xyz="0.4 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.25" effort="10" velocity="1"/>
  </joint>
  <joint name="l3_to_tool" type="fixed">
    <parent link="l3"/><child link="tool"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
  </joint>
</robot>
